---
import type { Article } from '../lib/content';
import { nameOf, getArticleComponent } from '../lib/content';
import { mdxComponents } from './mdx';
interface Props { article: Article; slug: string; headingLevel?: 'h1' | 'h2' | 'h5' }
const { article, slug, headingLevel = 'h2' } = Astro.props;
const id = nameOf(slug);
const heading = article.heading.length ? article.heading : [article.title, article.author].filter(Boolean);
const Heading = headingLevel;
const loader = getArticleComponent(slug);
const Content = loader ? (await loader()).default : null;
---
<article id={id} class={article.poem ? 'poem' : 'article'}>
  {!article.hideHeading && <Heading class="title-line flex flex-wrap mt-4! mb-12!">{heading.map(text => <span>{text}</span>)}</Heading>}
  <div class="article-text">
    {Content && <Content components={mdxComponents} />}
  </div>
</article>
