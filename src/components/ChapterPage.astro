---
import ReaderLayout from '../layouts/ReaderLayout.astro';
import ReadingPagination from './ReadingPagination';
import Article from './Article.astro';
import { getJournal, journalUrl, nameOf, getChapterComponent, description } from '../lib/content';
import { mdxComponents } from './mdx';

interface Props { slug: string }
const { slug } = Astro.props;
const { issueMap, chapterMap, articleMap } = await getJournal();
const chapter = chapterMap.get(slug)!;
const chapterLoader = getChapterComponent(slug);
const ChapterContent = chapterLoader ? (await chapterLoader()).default : null;
const bodyText = await chapter.body();
const issueName = slug.split('/')[0];
const issue = issueMap.get(issueName)!;
const name = nameOf(slug);
const index = issue.chapters.indexOf(slug);
const previous = issue.chapters[index - 1];
const next = issue.chapters[index + 1];
---
<ReaderLayout slug={slug} title={`${name} - ${issueName}`} description={chapter.subtitle.find(Boolean) || description(bodyText) || `${issueName} · ${name} 收录作品选集`}>
  <main id="main-content" class="reader-main flex flex-col items-center">
    <header class="flex flex-col items-center">
      <h1 class="chapter-title font-mingti my-0!">{name}</h1>
      <div class="chapter-rule my-4"></div>
      {chapter.subtitle.length > 0 && <div class="chapter-subtitle flex flex-col items-center font-kaiti text-justify">
        {chapter.subtitle.map(line => {
          const punctuation = /[、。！＂＇，．／：；？＼﹐﹑﹒]$/.test(line);
          return <p class="mb-0! relative no-indent">{punctuation ? line.slice(0, -1) : line}{punctuation && <span class="absolute">{line.slice(-1)}</span>}</p>;
        })}
        {chapter.subtitleCite && <p class="mb-0! self-end"><cite>——{chapter.subtitleCite}</cite></p>}
      </div>}
    </header>
    {ChapterContent && <div class="chapter-intro w-full max-w-2xl flex flex-col items-center"><ChapterContent components={mdxComponents} /></div>}
    {chapter.articles.map(path => <Article article={articleMap.get(path)!} slug={path} headingLevel="h2" />)}
    <ReadingPagination label="章节翻页" previous={previous ? { name: nameOf(previous), href: journalUrl(previous) } : undefined} next={next ? { name: nameOf(next), href: journalUrl(next) } : undefined} />
  </main>
</ReaderLayout>
