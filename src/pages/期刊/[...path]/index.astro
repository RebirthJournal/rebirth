---
import ChapterPage from '../../../components/ChapterPage.astro';
import { getJournal, journalUrl } from '../../../lib/content';
interface Props { slug: string; redirect?: string }

export async function getStaticPaths() {
  const journal = await getJournal();
  return [
    ...journal.issues.map(({ slug, entry }) => ({ params: { path: slug }, props: { slug, redirect: journalUrl(entry.chapters[0]) } })),
    ...journal.chapters.map(({ slug }) => ({ params: { path: slug }, props: { slug } })),
  ];
}

const { slug, redirect } = Astro.props;
if (redirect) return Astro.redirect(redirect, 302);
---
<ChapterPage slug={slug} />
