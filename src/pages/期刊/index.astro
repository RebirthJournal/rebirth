---
import Layout from '../../layouts/Layout.astro';
import { ogImagePath } from '../../lib/og/path';
import { getJournal } from '../../lib/content';
import IssueList from '../../components/IssueList';
const { settings, issueUrl } = await getJournal();
const issues = settings.issues.map(name => ({ name, href: issueUrl(name) }));
---
<Layout image={ogImagePath("journal")} title="期刊">
  <main id="main-content" class="archive-page journal-ui">
    <header class="archive-heading">
      <h1 class="font-mingti">全部期刊</h1>
    </header>
    <IssueList issues={issues} />
  </main>
</Layout>
