---
import Layout from '../../layouts/Layout.astro';
import { reader, description } from '../../lib/content';
import Figure from '../../components/Figure.astro';
import NoIndent from '../../components/NoIndent.astro';
import Right from '../../components/Right.astro';
import Center from '../../components/Center.astro';
import VerticalPoem from '../../components/VerticalPoem.astro';
import AboutContent from '../../content/settings/about.mdx';
const about = await reader.singletons.about.readOrThrow();
const bodyText = await about.body();
---
<Layout title="关于" description={description(bodyText)}>
  <main class="flex flex-col items-center">
    <h1 class="chapter-title font-mingti">{about.title}</h1>
    <div class="article-text">
      <AboutContent components={{ Figure, NoIndent, Right, Center, VerticalPoem }} />
    </div>
  </main>
</Layout>
